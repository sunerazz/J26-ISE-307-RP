# Comma-separated React origins (no wildcards)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional logging level for the API
API_LOG_LEVEL=INFO

# Optional LLM for human-readable station summaries
# If unset, a clear template explanation is used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
